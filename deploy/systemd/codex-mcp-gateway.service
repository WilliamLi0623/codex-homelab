[Unit]
Description=Codex Controller private MCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codex-mcp
Group=codex-mcp
ExecStart=/usr/local/bin/codex-mcp-gateway
EnvironmentFile=-/etc/codex/mcp-gateway.env
UnsetEnvironment=PROXMOX_TOKEN KUBERNETES_TOKEN CCH_API_KEY CODEX_MODEL_SECRET_KEY
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/codex-controller
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
